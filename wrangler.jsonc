{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zampy-landing",
  "main": "worker.js",
  "compatibility_date": "2026-07-25",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/worker.js", "/wrangler.jsonc"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
